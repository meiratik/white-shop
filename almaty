<style>
:root{--bg:#FAF7F2;--card:#FFFFFF;--ink:#2B2118;--mute:#5E5045;--accent:#7A4A2B;--on-accent:#FFFFFF;--line:#E6DDD0;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1C1612;--card:#261E18;--ink:#F5EEE6;--mute:#C9BBAA;--accent:#E0B48A;--on-accent:#1C1612;--line:#3A2F27;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#1C1612;--card:#261E18;--ink:#F5EEE6;--mute:#C9BBAA;--accent:#E0B48A;--on-accent:#1C1612;--line:#3A2F27;color-scheme:dark}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:80px}
body{margin:0;background:var(--bg);color:var(--ink);font:20px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
h1,h2{font-family:Georgia,"Times New Roman",serif;font-weight:400;line-height:1.2;margin:0}
h1{font-size:clamp(2.2rem,8vw,3.6rem)}
h2{font-size:2rem;margin-bottom:24px}
a{color:inherit}
.wrap{max-width:760px;margin:0 auto;padding:0 20px}
section{padding:56px 0;border-top:1px solid var(--line)}
header{position:sticky;top:0;background:var(--bg);border-bottom:1px solid var(--line);z-index:5}
header .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px}
.logo{display:flex;align-items:center;gap:10px;font-family:Georgia,serif;font-size:1.3rem;text-decoration:none}
.logo svg{width:34px;height:34px;stroke:var(--accent)}
nav{display:flex;gap:6px;flex-wrap:wrap}
nav a{padding:10px 12px;text-decoration:none;font-weight:600;border-radius:10px}
nav a:hover,nav a:focus{background:var(--card);outline:2px solid var(--accent)}
.hero{padding:72px 0 56px;text-align:center;border:0}
.hero svg{width:96px;height:96px;stroke:var(--accent);margin-bottom:20px}
.hero p{color:var(--mute);margin:16px 0 32px;font-size:1.2rem}
.btns{display:flex;flex-direction:column;gap:14px;max-width:420px;margin:0 auto}
.btn{display:block;padding:18px 24px;min-height:60px;border-radius:14px;text-align:center;text-decoration:none;font-weight:700;font-size:1.15rem;border:2px solid var(--accent)}
.btn.main{background:var(--accent);color:var(--on-accent)}
.btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.group{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:8px 20px;margin-bottom:20px}
.group h3{font-size:1.1rem;color:var(--accent);text-transform:uppercase;letter-spacing:.08em;margin:16px 0 4px}
.item{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px dashed var(--line)}
.item:last-child{border:0}
.item b{font-weight:700;white-space:nowrap}
.item small{display:block;color:var(--mute);font-size:.85rem;line-height:1.3}
.note{color:var(--mute);font-size:.9rem}
dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:12px 24px}
dt{color:var(--mute)}dd{margin:0;font-weight:600}
footer{padding:32px 0 96px;text-align:center;color:var(--mute);font-size:.9rem;border-top:1px solid var(--line)}
.bar{position:fixed;left:0;right:0;bottom:0;display:flex;gap:10px;padding:10px 14px calc(10px + env(safe-area-inset-bottom,0px));background:var(--bg);border-top:1px solid var(--line)}
.bar .btn{flex:1;padding:14px 8px;min-height:56px}
@media(min-width:700px){.btns{flex-direction:row;max-width:none;justify-content:center}.btn{min-width:230px}.bar{display:none}footer{padding-bottom:32px}}
@media(max-width:560px){nav{display:none}}
</style>
</head>
